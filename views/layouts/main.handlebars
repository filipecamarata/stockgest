<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
     <link rel="stylesheet" href="/css/breakpoints.css" media="all">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="shortcut icon" href="../../img/casa.png" type="image/x-icon">
    <title>Stockgest</title>
</head>
<body>
    <nav id="nav-bar">
        <ul class="icons">
            <li>
                <h2>Stockgest</h2>
            </li>  
            <li class="icone">
                <i id="burguer" class="bi bi-list" onclick="clickMenu()"></i>
            </li>                     
        </ul>

        <menu id="itens">          
            <ul  class="menu">
                 <!--URLS após autenticação-->   
                {{#if session.userid}}
                    <li>
                        <a href="/">Home</a>
                    </li>
                    <li>
                        <a href="/add">Cadastrar produto</a>
                    </li>
                    <li>
                        <a href="/products">Produtos</a>
                    </li>
                    <li>
                        <a href="/listaCompras">Lista de compras</a>
                    </li>           
                    <li>
                        <a href="/logout">Sair</a>
                    </li>          
                {{else}}
                 <!--URLS antes da autenticação-->   
                    <li>
                        <a href="/">Home</a>
                    </li>
                    <li>
                        <a href="/login">Entrar</a>
                    </li>
                    <li>
                        <a href="/registrar">Registrar</a>
                    </li>
                {{/if}}          
            </ul>
        </menu>        
    </nav>
    <header class="header-search">
        <form class="form-search" action="#" method="post">
            <input type="search" name="pesquisa" id="" placeholder="Buscar produto">
            <button type="submit">
                <i class="bi bi-search"></i>             
            </button>
        </form>
    </header>
     <div class="alerta-mensagem">
          <!--Mensagens-->
          {{#if messages.message}}
             <div class="message">
                 {{messages.message}}
              </div>
          {{/if}}        
    </div>
    {{{body}}}
    
    <footer id="footer-r">
        <div class="content-footer">
            <div class="contents-footer">
                <h3>Sobre Nós</h3>
                <p class="footer-p">De família para família, gerenciando com eficiência e praticidade.
Nossa essência está na organização e no cuidado com o que é essencial no dia a dia. Com o nosso aplicativo, você acompanha seu estoque doméstico com qualidade, controle e facilidade, garantindo que nunca falte o que realmente importa.</p> 
            </div>

            <div class="content-itens">
                <h3>Contato</h3>
                
                <ul class="icones-redes-sociais">
                    <li>
                        <a href="#">
                            <i class="bi bi-whatsapp"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com/filipecamarata" target="_blank">
                            <i class="bi bi-github"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.linkedin.com/in/filipe-camarata-711b75222/" target="_blank">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    </li>
                </ul>
            
            </div>
        </div>          
      
       <div>
           <p class="copy-p">&copy; Todos os direitos reservados a Filipe Camarata</p>
       </div>
    </footer>   
    
    <script>
        //Menu mobile
       function clickMenu(){
           if(itens.style.display == 'block'){
                itens.style.display = 'none'
            }else{
                itens.style.display = 'block'                                
            }
        }
    </script>
</body>
</html>