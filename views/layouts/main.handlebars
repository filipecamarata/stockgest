<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
     <link rel="stylesheet" href="/css/breakpoints.css" media="all">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <title>Stockgest</title>
</head>
<body>
    <nav id="nav-bar">
        <ul class="icons">
            <li>
                <h2>Stockgest</h2>
            </li>  
            <li class="icone">
                <i id="burguer" class="bi bi-list" onclick="clickMenu()"></i>
            </li>                     
        </ul>

        <menu id="itens">          
            <ul  class="menu">
                 <!--URLS após autenticação-->   
                {{#if session.userid}}
                    <li>
                        <a href="/">Home</a>
                    </li>
                    <li>
                        <a href="/add">Cadastrar produto</a>
                    </li>
                    <li>
                        <a href="/products">Produtos</a>
                    </li>
                    <li>
                        <a href="/listaCompras">Lista de compras</a>
                    </li>           
                    <li>
                        <a href="/logout">Sair</a>
                    </li>          
                {{else}}
                 <!--URLS antes da autenticação-->   
                    <li>
                        <a href="/">Home</a>
                    </li>
                    <li>
                        <a href="/login">Entrar</a>
                    </li>
                    <li>
                        <a href="/registrar">Registrar</a>
                    </li>
                {{/if}}          
            </ul>
        </menu>        
    </nav>
    <header class="header-search">
        <form class="form-search" action="#" method="post">
            <input type="search" name="pesquisa" id="" placeholder="Buscar produto">
            <button type="submit">
                <i class="bi bi-search"></i>             
            </button>
        </form>
    </header>
     <div class="container">
          <!--Mensagens-->
          {{#if messages.message}}
             <div class="message">
                 {{messages.message}}
              </div>
          {{/if}}        
    </div>
    {{{body}}}
    
    <footer id="footer-r">
        <ul>
            <li>
                <a href="#">Sobre nós</a>
            </li>
            <li>
                <a href="#">Contacto</a>
            </li>
        </ul>
        <p>&copy; Todos os direitos reservados a Filipe Camarata</p>
        <!--Nosso slogan “De família para família”
         representa a nossa verdadeira essência.
          Desde 1976 oferecemos qualidade, variedade e 
        encantamento para nossos clientes e fornecedores-->
    </footer>   
    
    <script>
        //Menu mobile
       function clickMenu(){
           if(itens.style.display == 'block'){
                itens.style.display = 'none'
            }else{
                itens.style.display = 'block'                                
            }
        }
    </script>
</body>
</html>