<main id="container">       
    

    <form class="form-main form-user-hei2" action="/login" method="post">
        <h1>Entrar</h1>       
        <div class="form-control">
            <label for="email">Email <span>*</span></label>
            <input type="text" name="email" id="email" placeholder="DIgite o seu email" required>
        </div>

        <div class="form-control">
            <label for="pass">Senha <span>*</span></label>
            <input type="password" name="password" id="pass" placeholder="Digite a sua senha" required>
        </div>
         
        </div>
        <div class="btn">
            <input class="btn-form" type="submit" value="Cadastrar">
        </div>
        <p>Não tem uma conta? <a href="/registrar">Clique aqui</a> </p>
    </form>

</main>